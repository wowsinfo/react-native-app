# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

min_target = min_ios_version_supported.to_f
$ios_target = [min_target, 16.0].max.to_s
platform :ios, $ios_target
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

$rn_config = use_native_modules!

def setup_common_pods
  use_react_native!(
    :path => $rn_config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
end

target "wowsinfo" do
  setup_common_pods
end

target "wowsinfo-debug" do
  setup_common_pods
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = $ios_target
      config.build_settings["CLANG_WARN_STRICT_PROTOTYPES"] = "NO"
    end
  end

  react_native_post_install(
    installer,
    $rn_config[:reactNativePath],
    :mac_catalyst_enabled => false
  )
end

post_integrate do |installer|
  # Generate missing module maps for prebuilt pods AFTER everything is set up
  headers_public = File.join(Pod::Config.instance.installation_root, "Pods/Headers/Public")

  # Only generate the ones that are actually needed by our project
  # Check which directories are referenced in the Swift compilation
  modules_needed = {
    "React" => "React-Core",
    "FlipperKit" => "FlipperKit",
    "ReactCommon" => "ReactCommon",
    "RCTTypeSafety" => "RCTTypeSafety",
    "React_Codegen" => "React-Codegen",
    "React_NativeModulesApple" => "React-NativeModulesApple",
    "folly" => "RCT-Folly",
    "yoga" => "Yoga",
  }

  modules_needed.each do |dir_name, module_name|
    dir_path = File.join(headers_public, dir_name)
    module_map_path = File.join(dir_path, "#{module_name}.modulemap")
    FileUtils.mkdir_p(dir_path)
    # Use valid Clang module identifier (no hyphens, no special chars)
    safe_name = module_name.gsub("-", "_")
    File.write(module_map_path, "module #{safe_name} {\n}\n")
    Pod::UI.puts "[ModuleMap] Generated module map: #{module_map_path}"
  end
end
