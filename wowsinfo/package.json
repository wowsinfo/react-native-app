{
  "name": "wowsinfo",
  "version": "1.7.0",
  "private": true,
  "packageManager": "bun@1.2.9",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios --scheme wowsinfo-debug --simulator=\"iPhone 17 Pro\"",
    "pod": "cd ios && pod install",
    "clean-ios": "cd ios && rm -rf Pods/ Podfile.lock",
    "lint": "bunx eslint . --ext .js,.jsx,.ts,.tsx",
    "format-all": "bunx prettier --write '**/*.js' '**/*.ts*'",
    "test": "bunx jest",
    "ios:dev": "bunx react-native run-ios --scheme wowsinfo-debug --simulator=\"iPhone 17 Pro\" --port 8088",
    "ios:release": "bunx react-native run-ios --scheme wowsinfo --configuration Release",
    "ios:prod": "bun run bundle:ios && bunx react-native run-ios --scheme wowsinfo --configuration Release",
    "bundle:ios": "bunx react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.0",
    "native-chart-experiment": "^1.0.2",
    "react-native-iap": "^7.0.3",
    "react-native-keep-awake": "^4.0.0",
    "react-native-localization": "^2.1.7",
    "react-native-paper": "^5.15.3",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.0",
    "react-native-super-grid": "^4.1.3"
  },
  "devDependencies": {
    "babel-plugin-transform-remove-console": "^6.9.4",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-async-storage/async-storage": "^1.15.5",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@react-native-community/cli": "latest",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "prettier": "^2.4.1",
    "react-native-animatable": "^1.3.3",
    "react-native-device-detection": "^0.2.1",
    "react-native-exception-handler": "^2.10.10",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-material-color": "^1.0.15",
    "react-native-reanimated": "^4.5.1",
    "react-native-worklets": "^0.10.2",
    "react-native-vector-icons": "^9.2.0",
    "react-test-renderer": "19.2.3",
    "string-format": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.12"
  }
}
